# Copy to .env for local runs (.env is gitignored). Same names as the GitHub Secrets.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=dapi...
SHEET_ID=paste-the-id-from-the-sheet-url
# The whole service-account JSON key on ONE line, wrapped in single quotes:
GOOGLE_SA_JSON='{"type": "service_account", "project_id": "...", ...}'
CATALOG=workspace
