{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "Headline numbers",
      "queryLines": [
        "WITH m AS (SELECT * FROM monthly_summary),\n",
        "t AS (SELECT term, min(month) AS first_month, sum(living_spend) AS living, sum(tracked_days) AS days FROM m GROUP BY term)\n",
        "SELECT\n",
        "  (SELECT living_spend FROM m ORDER BY month DESC LIMIT 1) AS month_living,\n",
        "  (SELECT avg_daily_living_spend FROM m ORDER BY month DESC LIMIT 1) AS month_per_day,\n",
        "  (SELECT round(living / days, 2) FROM t ORDER BY first_month DESC LIMIT 1) AS term_per_day\n"
      ]
    },
    {
      "name": "monthly",
      "displayName": "Monthly summary",
      "queryLines": [
        "SELECT month, term, tracked_days, living_spend, avg_daily_living_spend, one_off_spend,\n",
        "       reimbursable_paid, funding_received, paybacks_received\n",
        "FROM monthly_summary\n"
      ]
    },
    {
      "name": "terms",
      "displayName": "By term",
      "queryLines": [
        "SELECT term, min(month) AS first_month, sum(tracked_days) AS tracked_days,\n",
        "       round(sum(living_spend), 2) AS living_spend,\n",
        "       round(sum(living_spend) / sum(tracked_days), 2) AS living_per_day\n",
        "FROM monthly_summary GROUP BY term\n"
      ]
    },
    {
      "name": "categories",
      "displayName": "Purchases by category",
      "queryLines": [
        "SELECT month, term, category, round(sum(amount_sgd), 2) AS amount_sgd\n",
        "FROM fact_transaction WHERE is_living_spend GROUP BY month, term, category\n"
      ]
    },
    {
      "name": "daily",
      "displayName": "Daily living spend",
      "queryLines": [
        "SELECT date, term, living_spend, purchases FROM daily_living_spend\n"
      ]
    },
    {
      "name": "money_map",
      "displayName": "Money map",
      "queryLines": [
        "SELECT term,\n",
        "       CASE WHEN is_one_off THEN 'Tuition & hall'\n",
        "            WHEN is_reimbursable THEN 'Work money (paid back)'\n",
        "            ELSE 'Living' END AS spend_type,\n",
        "       coalesce(category, 'Others') AS category,\n",
        "       round(sum(amount_sgd), 2) AS amount_sgd\n",
        "FROM fact_transaction WHERE txn_kind = 'expense' GROUP BY ALL\n"
      ]
    }
  ],
